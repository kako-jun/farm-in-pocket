---
import CommunityList from "../components/CommunityList";
import MainLayout from "../layouts/MainLayout.astro";

// SSG (静的書き出し)。動的な /community/[npub] だけ SSR。
export const prerender = true;
---

<MainLayout
  title="みんな — Farm in Pocket (ポケ農)"
  description="ポケ農コミュニティの農家一覧。"
>
  <main class="min-h-screen text-neutral-900 p-4 pb-24 max-w-3xl mx-auto space-y-6">
    <header>
      <h1 class="text-2xl font-bold">🧑‍🌾 みんな</h1>
    </header>
    <section>
      <CommunityList client:load />
    </section>
  </main>
</MainLayout>
