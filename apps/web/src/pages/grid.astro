---
import GridEditor from "../components/GridEditor";
import MainLayout from "../layouts/MainLayout.astro";

// SSG (静的書き出し)。
export const prerender = true;
---

<MainLayout title="マイ畑 — Farm in Pocket (ポケ農)">
  <main class="min-h-screen text-neutral-900 p-4 pb-24 max-w-3xl mx-auto space-y-6">
    <header>
      <h1 class="text-2xl font-bold">🌱 マイ畑</h1>
    </header>
    <section>
      <GridEditor client:load />
    </section>
  </main>
</MainLayout>
