---
import RecordForm from "../components/RecordForm";
import MainLayout from "../layouts/MainLayout.astro";

// SSG (静的書き出し)。
export const prerender = true;
---

<MainLayout
  title="記録 — Farm in Pocket (ポケ農)"
  description="今日の作業（種まき・水やり・収穫など）を Nostr に投稿します。"
>
  <main class="min-h-screen text-neutral-900 p-4 pb-24 max-w-2xl mx-auto space-y-6">
    <header>
      <h1 class="text-2xl font-bold">📝 記録</h1>
    </header>
    <section>
      <RecordForm client:load />
    </section>
  </main>
</MainLayout>
