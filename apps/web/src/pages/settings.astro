---
import AccountSettings from "../components/AccountSettings";
import KeifunVoiceSettings from "../components/keifun/KeifunVoiceSettings";
import PrivacySettings from "../components/PrivacySettings";
import RegionSettings from "../components/RegionSettings";
import MainLayout from "../layouts/MainLayout.astro";

// SSG (静的書き出し)。
export const prerender = true;
---

<MainLayout title="設定 — Farm in Pocket (ポケ農)">
  <main class="min-h-screen text-neutral-900 p-6 pb-24 max-w-2xl mx-auto space-y-8">
    <header>
      <h1 class="text-2xl font-bold">設定</h1>
    </header>

    <section class="space-y-3">
      <h2 class="text-lg font-semibold">アカウント (Nostr 鍵)</h2>
      <AccountSettings client:load />
    </section>

    <section class="space-y-3">
      <h2 class="text-lg font-semibold">プライバシー</h2>
      <p class="text-sm text-neutral-600">
        初回起動時に表示される注意事項を、いつでも再表示できます。
      </p>
      <PrivacySettings client:load />
    </section>

    <section class="space-y-3">
      <h2 class="text-lg font-semibold">地域（気象データ用）</h2>
      <p class="text-sm text-neutral-600">
        市区町村レベルで地域を設定すると、屋外グリッドの作業日に気温・天気・日照時間を
        Open-Meteo から取得して「今日のおせわ」に表示します。
      </p>
      <RegionSettings client:load />
    </section>

    <section class="space-y-3">
      <h2 class="text-lg font-semibold">けいふんくんの読み上げ</h2>
      <p class="text-sm text-neutral-600">
        けいふんくんが声に出してメッセージを読み上げます。設定は端末ごとに保存されます。
      </p>
      <KeifunVoiceSettings client:load />
    </section>

    <section class="space-y-3">
      <h2 class="text-lg font-semibold">その他</h2>
      <p class="text-sm text-neutral-500">
        （その他の設定は今後追加）
      </p>
    </section>
  </main>
</MainLayout>
